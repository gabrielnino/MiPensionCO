# RETINA / Outlier Vault — documentation template, reviewed 2026-09-18.
# Copy to config/.env only when it does not exist; merge into an existing file.
# Never commit real credentials. See docs/AUTHENTICATION.md and docs/RESEARCH.md.

# Auth0: exact issuer, application credentials and browser origin.
AUTH0_ISSUER=https://YOUR-TENANT.auth0.com/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
APP_ORIGIN=http://localhost:8787
AUTH0_EVENT_SECRET=

# PostgreSQL required on Vercel. DATABASE_URL takes precedence over POSTGRES_URL.
# Leave empty for local SQLite; initialize identity explicitly before startup.
DATABASE_URL=
AUTH_LOCAL_DATABASE=config/identity.sqlite3

# Enable only after applying research migrations and preparing the host.
RESEARCH_ENABLED=0
# Pass --root explicitly to the host/launcher when the external CLI is elsewhere.

# AI providers: keys are required for their respective operations.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Image model is selected in the request and validated by OpenRouterImageService.
# No global timeout or OPENROUTER_DEFAULT_MODEL env setting is read by ai_service.py.

# Sales funnel analysis (TOFU, BOFU, Lead Magnet)
FUNNEL_ENABLED=0
YOUTUBE_API_KEY=
FUNNEL_LLM_PROVIDER=deepseek
FUNNEL_LLM_MODEL=deepseek-flash
FUNNEL_MAX_LLM_CALLS=400
